
def dfs(start, goal):
    stack = [(start, [start])]
    visited = set()

    while stack:
        state, path = stack.pop()

        if state == goal:
            for s in path:
                print(s[:3], s[3:6], s[6:])
            print("Number of moves:", len(path) - 1)
            return

        if state in visited:
            continue
        visited.add(state)

        z = state.index(0)
        r, c = divmod(z, 3)

        for d in [3, -3, 1, -1]:
            nz = z + d
            if 0 <= nz < 9 and abs(nz // 3 - r) + abs(nz % 3 - c) == 1:
                t = list(state)
                t[z], t[nz] = t[nz], t[z]
                t = tuple(t)
                if t not in visited:
                    stack.append((t, path + [t]))

start = (1, 2, 3, 0, 4, 6, 7, 5, 8)
goal = (1, 2, 3, 4, 5, 6, 7, 8, 0)
dfs(start, goal)
