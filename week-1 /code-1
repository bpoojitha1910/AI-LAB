board = [
    'O', ' ', 'X',
    'X', ' ', ' ',
    'X', 'O', 'O'
]

def print_board():
    print(f" {board[0]} | {board[1]} | {board[2]} ")
    print("---+---+---")
    print(f" {board[3]} | {board[4]} | {board[5]} ")
    print("---+---+---")
    print(f" {board[6]} | {board[7]} | {board[8]} ")
    print()

def check_winner(player_symbol):
    winning_combinations = [
        (0, 1, 2), (3, 4, 5), (6, 7, 8), # Rows
        (0, 3, 6), (1, 4, 7), (2, 5, 8), # Columns
        (0, 4, 8), (2, 4, 6)             # Diagonals
    ]

    for a, b, c in winning_combinations:
        if board[a] == board[b] == board[c] == player_symbol:
            return True
    return False

def is_board_full():
    return ' ' not in board

def play_game():
    # Determine starting player based on current board state
    x_count = board.count('X')
    o_count = board.count('O')

    # If X and O counts are equal, X plays next. Otherwise, the player with fewer moves plays next.
    current_player_symbol = 'X' if x_count <= o_count else 'O'

    print("Welcome to Tic-Tac-Toe!")
    print("Starting board:")
    print_board()
    print(f"Player {current_player_symbol}'s turn to play.")
    print("Choose a position from 1 to 9 (empty cells are marked as spaces):")
    print()

    game_winner = None # To store the winner if found
    while True:
        # Check if a winner has been determined, but continue if board is not full
        if game_winner:
            print(f"Player {game_winner} has already won, but let's fill the rest of the board!")

        try:
            position = int(input(f"Player {current_player_symbol}, choose a position (1-9): "))
        except ValueError:
            print("Please enter a number from 1 to 9.")
            continue

        if not (1 <= position <= 9):
            print("Please choose a number between 1 and 9.")
            continue

        index = position - 1

        if board[index] != ' ': # Check if cell is empty (' ')
            print("That position is already taken!")
            continue

        board[index] = current_player_symbol # Make move
        print_board() # Print board after each move

        if check_winner(current_player_symbol) and not game_winner:
            print(f"Player {current_player_symbol} wins!")
            game_winner = current_player_symbol

        if is_board_full():
            if game_winner:
                print(f"Game over! Player {game_winner} won. The board is now full.")
                print("poojitha-1WA24CS079")
            else:
                print("It's a draw!")
                print("poojitha-1WA24CS079")
            break

        # Switch players
        current_player_symbol = 'O' if current_player_symbol == 'X' else 'X'

# Call to start the game
play_game()
