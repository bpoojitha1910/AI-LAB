import heapq

def h(s, goal):
    return sum(s[i] != goal[i] and s[i] != 0
               for i in range(9))

def astar(start, goal):
    pq = [(h(start, goal), 0, start, [start])]
    visited = set()

    while pq:
        f, g, s, path = heapq.heappop(pq)

        if s == goal:
            for x in path:
                print(x[:3], x[3:6], x[6:])
            print("Moves:", g)
            return

        if s in visited:
            continue
        visited.add(s)

        z = s.index(0)
        r, c = z // 3, z % 3

        for dr, dc in [(1,0), (-1,0), (0,1), (0,-1)]:
            nr, nc = r + dr, c + dc
            if 0 <= nr < 3 and 0 <= nc < 3:
                nz = nr * 3 + nc
                b = list(s)
                b[z], b[nz] = b[nz], b[z]
                ns = tuple(b)

                if ns not in visited:
                    heapq.heappush(
                        pq, (g + 1 + h(ns, goal),
                             g + 1, ns, path + [ns])
                    )

    print("No solution found")

start = (5,4,0,6,1,8,7,3,2)
goal = (0,1,2,3,4,5,6,7,8)

astar(start, goal)
