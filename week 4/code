from itertools import combinations

def cost(state):
    count = 0
    for i in range(4):
        for j in range(i + 1, 4):
            if state[i] == state[j] or abs(state[i] - state[j]) == abs(i - j):
                count += 1
    return count

state = [3, 1, 2, 0]
step = 0

while True:
    current_cost = cost(state)
    print("Step:", step)
    print("Current state:", tuple(state))
    print("Current cost:", current_cost)

    if current_cost == 0:
        print("Goal state reached!")
        break

    neighbors = []

    for i, j in combinations(range(4), 2):
        new_state = state.copy()
        new_state[i], new_state[j] = new_state[j], new_state[i]
        neighbors.append((cost(new_state), i, j, new_state))

    print("Neighbor costs:")
    for c, i, j, s in neighbors:
        print("Swap", (i, j), "State:", tuple(s), "Cost:", c)

    best = min(neighbors, key=lambda x: (x[0], x[1], x[2]))

    if best[0] >= current_cost:
        print("No better neighbor. Stopping.")
        break

    state = best[3]
    step += 1
    print("Selected state:", tuple(state))
    print()
